  "git_workflow": {
    "branch_naming": {
      "pattern": "{type}/{issue-key}-{short-description}",
      "examples": [
        "feat/P-15-viva-splash-screen",
        "fix/P-16-audio-background-play",
        "refactor/P-11-session-analysis"
      ],
      "types": ["feat", "fix", "refactor", "docs", "test", "chore"]
    },
    "worktree_convention": {
      "base_path": "~/usr/projects/worktrees",
      "naming": "{project}/{issue-key}",
      "examples": [
        "~/usr/projects/worktrees/viva/P-15",
        "~/usr/projects/worktrees/viva/P-16"
      ]
    },
    "commit_message": {
      "pattern": "{type}({scope}): {description} [{issue-key}]",
      "examples": [
        "feat(splash): add animated logo [P-15]",
        "fix(audio): enable background playback [P-16]"
      ]
    },
    "pr_template": {
      "title": "[{issue-key}] {description}",
      "body_includes": ["Linear issue link", "Test checklist", "Screenshots if GUI"]
    }
  }
